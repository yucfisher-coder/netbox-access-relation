ARG NETBOX_IMAGE=docker.io/netboxcommunity/netbox:v4.7.2-5.1.1@sha256:6f7177d3ff4db2d65212420a4d8dffab22e15de0d767c2bf3b06d36e588df5e9
FROM ${NETBOX_IMAGE}

USER root

COPY locks/dev-requirements.txt /tmp/dev-requirements.txt
RUN /usr/local/bin/uv pip install \
      --python /opt/netbox/venv/bin/python \
      --no-cache \
      --requirement /tmp/dev-requirements.txt \
    && rm /tmp/dev-requirements.txt \
    && chmod -R g+w /opt/netbox/venv

COPY docker/dev-entrypoint.sh /opt/netbox/dev-entrypoint.sh
RUN chmod 0755 /opt/netbox/dev-entrypoint.sh

WORKDIR /opt/netbox/netbox
