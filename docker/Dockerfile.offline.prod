ARG PYTHON_BUILD_IMAGE=python:3.12-slim
ARG NETBOX_IMAGE=docker.io/netboxcommunity/netbox:v4.7.2-5.1.1@sha256:3cf9d3bd77aa186233b84d0ea1cf1755581d5e5678fa7d86ec3be62f79d0c643

FROM ${PYTHON_BUILD_IMAGE} AS plugin-builder
WORKDIR /build
COPY pyproject.toml README.md LICENSE MANIFEST.in CHANGELOG.md COMPATIBILITY.md CONTRIBUTING.md SECURITY.md ./
COPY netbox_access_relations/ ./netbox_access_relations/
COPY locks/production-requirements.txt /tmp/production-requirements.txt
COPY offline-wheelhouse/ /offline-wheelhouse/
RUN python -m pip wheel --no-index --find-links=/offline-wheelhouse --no-deps --wheel-dir /wheelhouse . \
    && python -m pip wheel --no-index --find-links=/offline-wheelhouse --no-deps --wheel-dir /wheelhouse \
      --requirement /tmp/production-requirements.txt

FROM scratch AS wheel
COPY --from=plugin-builder /wheelhouse/ /

FROM ${NETBOX_IMAGE} AS runtime
USER root
COPY --from=plugin-builder /wheelhouse/ /tmp/wheelhouse/
COPY config/plugins.py /etc/netbox/config/plugins.py
RUN /usr/local/bin/uv pip install \
      --python /opt/netbox/venv/bin/python \
      --no-deps \
      --offline \
      /tmp/wheelhouse/et_xmlfile-*.whl \
      /tmp/wheelhouse/openpyxl-*.whl \
      /tmp/wheelhouse/netbox_access_relations-*.whl \
    && rm -rf /tmp/wheelhouse
USER netbox
WORKDIR /opt/netbox/netbox
