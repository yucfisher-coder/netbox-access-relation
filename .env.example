# Copy with scripts/init-env. Never commit populated values.
NETBOX_HTTP_PORT=8000
ALLOWED_HOSTS=localhost 127.0.0.1

DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=REPLACE_WITH_GENERATED_VALUE

REDIS_PASSWORD=REPLACE_WITH_GENERATED_VALUE
REDIS_CACHE_PASSWORD=REPLACE_WITH_GENERATED_VALUE
SECRET_KEY=REPLACE_WITH_GENERATED_VALUE_AT_LEAST_50_CHARACTERS
API_TOKEN_PEPPER_1=REPLACE_WITH_GENERATED_VALUE

SKIP_SUPERUSER=true
CENSUS_REPORTING_ENABLED=false
RELEASE_CHECK_URL=
