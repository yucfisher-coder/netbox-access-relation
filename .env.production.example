# Copy to .env.production on the production host and inject real secrets at runtime.
NETBOX_PRODUCTION_IMAGE=netbox-access-relations:1.0.3
NETBOX_HTTP_PORT=8000
ALLOWED_HOSTS=netbox.example.internal localhost 0.0.0.0

DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=REPLACE_WITH_SECRET
DB_SSLMODE=prefer

REDIS_PASSWORD=REPLACE_WITH_SECRET
REDIS_CACHE_PASSWORD=REPLACE_WITH_SECRET
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_VALUE_AT_LEAST_50_CHARACTERS_LONG
API_TOKEN_PEPPER_1=REPLACE_WITH_A_RANDOM_API_TOKEN_PEPPER_AT_LEAST_50_CHARACTERS_LONG

POSTGRES_VOLUME_NAME=netbox-access-relations-prod-postgres18-v1
MEDIA_VOLUME_NAME=netbox-access-relations-prod-media-v1
REDIS_VOLUME_NAME=netbox-access-relations-prod-redis-v1

SKIP_SUPERUSER=true
CENSUS_REPORTING_ENABLED=false
RELEASE_CHECK_URL=
