#!/bin/bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_release-common.sh"

dist_dir="${repo_root}/dist"

verify_locked_base_image

mkdir -p "${dist_dir}"
docker build \
  --file "${repo_root}/docker/Dockerfile.prod" \
  --target wheel \
  --output "type=local,dest=${dist_dir}" \
  "${repo_root}"
docker build \
  --file "${repo_root}/docker/Dockerfile.prod" \
  --target runtime \
  --build-arg "NETBOX_IMAGE=${base_image}" \
  --tag "${image_name}" \
  "${repo_root}"

sha256sum "${dist_dir}"/*.whl > "${dist_dir}/SHA256SUMS"
docker image inspect "${image_name}" --format '{{.Id}}' > "${dist_dir}/IMAGE_ID"

echo "Built ${image_name} and wheel artifacts in ${dist_dir}."
